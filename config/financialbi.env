# =============================================================================
# FinancialBI — conexión a datos (DESARROLLO LOCAL)
# Se inyecta como env_file en docker-compose.yml. Cambios aquí solo requieren
# reiniciar carb-financialbi (no rebuild).
# =============================================================================

# --- BigQuery ---
# Mismo proyecto que Maka (proan-quantrue) -- las tablas propias de
# Hidrocarburos (HCARB_*) viven en D50_AGGREGATE_RENTABILIDAD/D60_REPORTING,
# ver ConsultasBigQuery/ y Datos/PHASE2/.
BQ_PROJECT_ID=proan-quantrue
BQ_LOCATION=us-west4
BQ_CREDENTIALS_PATH=/app/config/bq_credentials.json

# --- Prueba rama Fer: HCARB_GOLD_CLASIFICACION_FOLIO desde D30_INTEGRATION.cfdi_completo ---
# Tabla de prueba (no la de producción) -- ver ConsultasBigQuery/HCARB_gold_clasificacion_fer.sql.
# Quita esta línea para volver a la tabla real HCARB_GOLD_CLASIFICACION_FOLIO.
HCARB_FOLIO_TABLE=proan-quantrue.D60_REPORTING.HCARB_GOLD_CLASIFICACION_FOLIO_fer
