# =============================================================================
# FinancialBI — conexión a datos (DESARROLLO LOCAL)
# Se inyecta como env_file en docker-compose.yml. Cambios aquí solo requieren
# reiniciar carb-financialbi (no rebuild).
# =============================================================================

# --- BigQuery ---
# Mismo proyecto que Maka (proan-quantrue) -- las tablas propias de
# Hidrocarburos (HCARB_*) viven en D50_AGGREGATE_RENTABILIDAD/D60_REPORTING,
# ver ConsultasBigQuery/ y Datos/PHASE2/.
BQ_PROJECT_ID=proan-quantrue
BQ_LOCATION=us-west4
BQ_CREDENTIALS_PATH=/app/config/bq_credentials.json

# --- Prueba rama Fer: HCARB_GOLD_CLASIFICACION_FOLIO desde D30_INTEGRATION.cfdi_completo ---
# Tabla de prueba (no la de producción) -- ver ConsultasBigQuery/HCARB_gold_clasificacion_fer.sql.
# Quita esta línea para volver a la tabla real HCARB_GOLD_CLASIFICACION_FOLIO.
HCARB_FOLIO_TABLE=proan-quantrue.D60_REPORTING.HCARB_GOLD_CLASIFICACION_FOLIO_fer
# Idem para HCARB_GOLD_VALIDACION_SAP -- ver ConsultasBigQuery/HCARB_gold_validacion_sap_fer.sql
# (desglose MSEG por ticket de entrega).
HCARB_SAP_TABLE=proan-quantrue.D60_REPORTING.HCARB_GOLD_VALIDACION_SAP_fer

# --- Prueba rama Fer: CECO por ticket en el Modulo 3 (aprobacion_engine.py) ---
# HCARB_gold_aprobacion es mutable (la crea/puebla el propio backend, no un .sql de
# ConsultasBigQuery/) -- apuntar aqui hace que se cree y pueble sola, vacia, la
# primera vez que se use. Sin esto, las pruebas locales (validar/aprobar/rechazar/
# reabrir) escribirian en la tabla real de produccion. Quita esta linea para volver
# a la tabla real HCARB_gold_aprobacion.
HCARB_APROBACION_TABLE=proan-quantrue.D60_REPORTING.HCARB_gold_aprobacion_fer

# --- Nucleos de consumo de gas (dashboard) ---
# Borrador del cruce Nucleo<->CeCo (propuesta Methagas x catalogo SAP real),
# ver el chat/artefacto de revision. Todavia tiene filas pendiente_confirmar.
# Quita esta linea para volver al nombre final HCARB_dim_nucleo (sin crear
# todavia -- se crea al promover el borrador).
HCARB_NUCLEO_TABLE=proan-quantrue.D60_REPORTING.HCARB_dim_nucleo_draft
